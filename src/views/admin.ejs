<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Stratic Admin</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,-apple-system,sans-serif;background:#0f1111;color:#fff;min-height:100vh;padding:20px}
.box{max-width:480px;margin:40px auto;background:#1a1a1a;border-radius:12px;padding:24px}
h1{font-size:20px;margin-bottom:12px;color:#ff9900}
input,button{width:100%;padding:12px;border-radius:8px;border:1px solid #333;background:#111;color:#fff;margin:8px 0;font-size:16px}
button{background:#ff9900;color:#111;font-weight:700;border:0;cursor:pointer}
button:active{transform:scale(.97)}
.err{color:#ff6b6b;font-size:14px;min-height:18px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}
.card{background:#222;border-radius:10px;padding:16px}
.card b{display:block;font-size:28px;color:#ff9900}
.card span{font-size:12px;color:#aaa}
table{width:100%;border-collapse:collapse;font-size:13px;margin-top:12px}
td,th{padding:8px;border-bottom:1px solid #333;text-align:left}
.hidden{display:none}
#dash{max-width:900px;margin:0 auto}
</style>
</head>
<body>
<div id="login" class="box">
  <h1>🔒 Private Dashboard</h1>
  <p style="color:#888;font-size:13px;margin-bottom:12px">Password protected. Not for public.</p>
  <input type="password" id="pass" placeholder="Admin password" autocomplete="current-password">
  <div class="err" id="err"></div>
  <button id="go">Unlock</button>
</div>
<div id="dash" class="hidden">
  <h1 style="margin-bottom:16px">📊 Stratic Live Stats</h1>
  <div class="grid">
    <div class="card"><b id="u">0</b><span>Users</span></div>
    <div class="card"><b id="p">0</b><span>Products posted</span></div>
    <div class="card"><b id="o">0</b><span>Orders</span></div>
    <div class="card"><b id="c">0</b><span>Countries active</span></div>
  </div>
  <h2 style="font-size:16px;margin:20px 0 8px;color:#ff9900">By country</h2>
  <table><thead><tr><th>Country</th><th>Products</th><th>Orders</th></tr></thead><tbody id="byc"></tbody></table>
  <h2 style="font-size:16px;margin:20px 0 8px;color:#ff9900">Recent products</h2>
  <table><thead><tr><th>Title</th><th>Country</th><th>Price</th><th>When</th></tr></thead><tbody id="rp"></tbody></table>
  <h2 style="font-size:16px;margin:20px 0 8px;color:#ff9900">Recent orders</h2>
  <table><thead><tr><th>Ref</th><th>Country</th><th>Total</th><th>Status</th></tr></thead><tbody id="ro"></tbody></table>
</div>
<script>
document.getElementById('go').onclick=function(){
  var pass=document.getElementById('pass').value;
  fetch('/shop/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json','x-sgm':'1'},body:JSON.stringify({password:pass})})
  .then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error||'Fail');return d;});})
  .then(function(){document.getElementById('login').classList.add('hidden');document.getElementById('dash').classList.remove('hidden');load();})
  .catch(function(e){document.getElementById('err').textContent=e.message;});
};
function load(){
  fetch('/shop/api/admin/stats').then(function(r){if(!r.ok)throw 0;return r.json();}).then(function(d){
    document.getElementById('u').textContent=d.users;
    document.getElementById('p').textContent=d.products;
    document.getElementById('o').textContent=d.orders;
    var keys=Object.keys(d.byCountry||{});
    document.getElementById('c').textContent=keys.length;
    var byc=document.getElementById('byc');byc.innerHTML='';
    keys.forEach(function(k){var tr=document.createElement('tr');tr.innerHTML='<td>'+k+'</td><td>'+d.byCountry[k].products+'</td><td>'+d.byCountry[k].orders+'</td>';byc.appendChild(tr);});
    var rp=document.getElementById('rp');rp.innerHTML='';
    (d.recentProducts||[]).forEach(function(p){var tr=document.createElement('tr');tr.innerHTML='<td>'+p.title+'</td><td>'+p.country+'</td><td>'+p.currency+' '+p.price+'</td><td>'+new Date(p.createdAt).toLocaleString()+'</td>';rp.appendChild(tr);});
    var ro=document.getElementById('ro');ro.innerHTML='';
    (d.recentOrders||[]).forEach(function(o){var tr=document.createElement('tr');tr.innerHTML='<td>'+o.ref+'</td><td>'+o.country+'</td><td>'+o.currency+' '+o.total+'</td><td>'+o.status+'</td>';ro.appendChild(tr);});
  }).catch(function(){});
}
// auto try if cookie present
fetch('/shop/api/admin/stats').then(function(r){if(r.ok){document.getElementById('login').classList.add('hidden');document.getElementById('dash').classList.remove('hidden');return r.json();}throw 0;}).then(function(d){
  document.getElementById('u').textContent=d.users;document.getElementById('p').textContent=d.products;document.getElementById('o').textContent=d.orders;
  var keys=Object.keys(d.byCountry||{});document.getElementById('c').textContent=keys.length;
}).catch(function(){});
</script>
</body>
</html>
