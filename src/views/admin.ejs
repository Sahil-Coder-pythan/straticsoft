<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#101010"><title>Private Dashboard · Stratic Market</title>
<style>
:root{color-scheme:light;--orange:#f5660a;--ink:#141414;--muted:#6b7280;--line:#e7e7e7;--bg:#f5f6f8}*{box-sizing:border-box}body{margin:0;background:var(--bg);font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink)}header{background:#101010;color:#fff;padding:18px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px}header strong{font-size:21px;letter-spacing:-.5px}header strong span{color:var(--orange)}header small{color:#c8c8c8}.wrap{max-width:1180px;margin:24px auto;padding:0 16px}.panel{background:white;border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 6px 22px #00000008;margin-bottom:18px}.login{max-width:420px;margin:9vh auto}.login h1{margin-top:0}.hint{color:var(--muted);font-size:13px}input{width:100%;padding:14px;border:1px solid #d8d8d8;border-radius:10px;font:inherit;margin:10px 0 14px}button{border:0;border-radius:11px;padding:12px 18px;background:var(--orange);color:white;font:600 15px system-ui;cursor:pointer}button.secondary{background:#222}button:disabled{opacity:.6}.error{color:#b42318;min-height:20px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.stat{border:1px solid var(--line);border-radius:14px;padding:17px}.stat small{color:var(--muted);display:block}.stat strong{font-size:28px;display:block;margin-top:5px}.tables{display:grid;grid-template-columns:1fr;gap:18px}h2{font-size:19px;margin:0 0 14px} .table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;white-space:nowrap}th,td{text-align:left;padding:11px 12px;border-bottom:1px solid #eee;font-size:13px}th{background:#fafafa;color:#555}td{max-width:260px;overflow:hidden;text-overflow:ellipsis}.pill{display:inline-block;padding:3px 8px;border-radius:99px;background:#e9f8ef;color:#17663a;font-size:12px}.topline{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.hidden{display:none!important}@media(max-width:650px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:16px}.stat strong{font-size:24px}header strong{font-size:18px}}
</style></head><body>
<header><div><strong>stratic<span>market</span></strong><br><small>Private owner dashboard</small></div><a href="/shop" style="color:#fff;text-decoration:none;font-size:13px">Open public shop ↗</a></header>
<div class="wrap">
<section id="login-panel" class="panel login"><h1>Private Dashboard</h1><p class="hint">Owner access only. Enter the dashboard password to continue.</p><form id="login-form"><label for="password">Dashboard password</label><input id="password" name="password" type="password" autocomplete="current-password" required><button id="login-btn" type="submit" style="width:100%">Unlock dashboard</button><p id="login-error" class="error" role="alert"></p></form><p class="hint">Public shop: <code>/shop</code> · Private dashboard: <code>/shop/admin</code></p></section>
<section id="dashboard" class="hidden">
<div class="topline" style="margin:0 0 16px"><div><h1 style="margin:0">Marketplace overview</h1><p class="hint" style="margin:4px 0">Visitor count means shop page views, not verified unique people. Country totals come from account/product/order country fields.</p></div><button class="secondary" id="logout">Log out</button></div>
<div class="stats panel" id="stats"><div class="stat"><small>Shop page views</small><strong id="visits">—</strong></div><div class="stat"><small>Registered accounts</small><strong id="users">—</strong></div><div class="stat"><small>Products uploaded</small><strong id="products">—</strong></div><div class="stat"><small>Orders</small><strong id="orders">—</strong></div></div>
<div class="panel"><h2>Country summary</h2><div class="table-wrap"><table><thead><tr><th>Country code</th><th>Products</th><th>Orders</th></tr></thead><tbody id="countries"></tbody></table></div></div>
<div class="panel"><h2>Recent products</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Seller / shop</th><th>Country</th><th>Price</th><th>Uploaded</th></tr></thead><tbody id="recent-products"></tbody></table></div></div>
<div class="panel"><h2>Recent orders</h2><div class="table-wrap"><table><thead><tr><th>Order reference</th><th>Total</th><th>Country</th><th>Status</th><th>Order date</th></tr></thead><tbody id="recent-orders"></tbody></table></div></div>
<div class="panel"><h2>Daily shop views</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Page views</th></tr></thead><tbody id="daily-visits"></tbody></table></div></div>
<p class="hint">Dashboard data is limited to information stored by the current app. Country analytics are not IP-based geolocation. Data persistence depends on the app's configured storage.</p>
</section><p id="load-error" class="error"></p></div>
<script>
const $=id=>document.getElementById(id);const fmtDate=v=>{if(!v)return '—';const d=new Date(v);return Number.isNaN(d.getTime())?'—':d.toLocaleString()};const esc=v=>String(v??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function loadStats(){const r=await fetch('/shop/api/admin/stats',{credentials:'same-origin'});if(r.status===401){$('dashboard').classList.add('hidden');$('login-panel').classList.remove('hidden');return}if(!r.ok)throw Error('Could not load dashboard data.');const d=await r.json();$('login-panel').classList.add('hidden');$('dashboard').classList.remove('hidden');$('visits').textContent=d.visits??0;$('users').textContent=d.users??0;$('products').textContent=d.products??0;$('orders').textContent=d.orders??0;
const countryRows=Object.entries(d.byCountry||{}).sort((a,b)=>(b[1].products+b[1].orders)-(a[1].products+a[1].orders));$('countries').innerHTML=countryRows.length?countryRows.map(([c,v])=>`<tr><td>${esc(c)}</td><td>${v.products||0}</td><td>${v.orders||0}</td></tr>`).join(''):'<tr><td colspan="3">No country data yet</td></tr>';
$('recent-products').innerHTML=(d.recentProducts||[]).map(p=>`<tr><td>${esc(p.title)}</td><td>${esc(p.seller)}</td><td>${esc(p.country)}</td><td>${esc(p.currency)} ${esc(p.price)}</td><td>${esc(fmtDate(p.createdAt))}</td></tr>`).join('')||'<tr><td colspan="5">No products yet</td></tr>';
$('recent-orders').innerHTML=(d.recentOrders||[]).map(o=>`<tr><td>${esc(o.ref)}</td><td>${esc(o.currency)} ${esc(o.total)}</td><td>${esc(o.country)}</td><td><span class="pill">${esc(o.status)}</span></td><td>${esc(fmtDate(o.createdAt))}</td></tr>`).join('')||'<tr><td colspan="5">No orders yet</td></tr>';
$('daily-visits').innerHTML=Object.entries(d.dailyVisits||{}).sort((a,b)=>b[0].localeCompare(a[0])).map(([day,count])=>`<tr><td>${esc(day)}</td><td>${count}</td></tr>`).join('')||'<tr><td colspan="2">No visits recorded yet</td></tr>';
}
$('login-form').addEventListener('submit',async e=>{e.preventDefault();$('login-error').textContent='';$('login-btn').disabled=true;try{const r=await fetch('/shop/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json','x-sgm':'1'},credentials:'same-origin',body:JSON.stringify({password:$('password').value})});const d=await r.json();if(!r.ok)throw Error(d.error||'Login failed');$('password').value='';await loadStats()}catch(e){$('login-error').textContent=e.message}finally{$('login-btn').disabled=false}});
$('logout').addEventListener('click',async()=>{await fetch('/shop/api/admin/logout',{method:'POST',headers:{'x-sgm':'1'},credentials:'same-origin'});$('dashboard').classList.add('hidden');$('login-panel').classList.remove('hidden')});
loadStats().catch(e=>{$('load-error').textContent=e.message});
</script></body></html>
