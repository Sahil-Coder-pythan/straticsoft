<!doctype html>
<html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#14396b"><title>Stratic Market</title><link rel="stylesheet" href="/static/css/shop.css"></head>
<body>
<header class="sh-top"><div class="sh-logo">STRATIC <span>MARKET</span></div><a class="sh-cartlink" id="open-cart" href="#" aria-label="Cart">🛒<b id="cart-n">0</b></a></header>
<div class="sh-search"><input id="q" type="search" placeholder="Search Stratic Market" aria-label="Search"></div>
<div class="sh-tabs" id="tabs"></div>
<div class="sh-bar"><h1 id="head">All products</h1><select id="sort" aria-label="Sort"><option value="new">Sort: Newest</option><option value="lo">Price: low to high</option><option value="hi">Price: high to low</option></select></div>
<main id="grid" class="sh-grid"><p class="sh-empty">Loading products…<br><small style="opacity:.7">First open can take 30–60 sec on free server</small></p></main>
<nav class="sh-nav">
  <a href="/shop" class="on"><span class="ni">⌂</span><span>Home</span></a>
  <a href="/market"><span class="ni">▶</span><span>Videos</span></a>
  <button id="open-sell" class="sh-plus" aria-label="Sell a product">+</button>
  <a href="#" id="open-cart2"><span class="ni">🛒</span><span>Cart</span></a>
  <a href="#" id="open-acc"><span class="ni">👤</span><span>Account</span></a>
</nav>
<dialog id="sell"><form id="sell-form">
<div class="sh-row"><h2>Sell a product</h2><button type="button" id="sell-close" class="sh-x">✕</button></div>
<div class="sh-photo"><img id="prev" alt="" hidden><div id="prev-t" class="sh-pick"><label class="sh-pb">📷 Take photo<input type="file" id="photo-cam" accept="image/*" capture="environment" hidden></label><label class="sh-pb">🖼 From gallery<input type="file" id="photo-gal" accept="image/*" hidden></label></div></div>
<label class="sh-chk"><input type="checkbox" id="rm" checked> Auto: white background, brighten &amp; straighten</label>
<p id="proc" role="status"></p>
<label>Product name / प्रोडक्ट का नाम<input name="title" maxlength="140" required placeholder="e.g. iPhone 13 128GB"></label>
<div class="sh-2"><label>Price / कीमत<input name="price" type="number" min="1" step="any" required></label><label>Currency<select name="currency"><option>INR</option><option>USD</option><option>EUR</option><option>GBP</option><option>AED</option></select></label></div>
<label>Category<select name="category"><option>Mobiles</option><option>Fashion</option><option>Electronics</option><option>Home &amp; Kitchen</option><option>Other</option></select></label>
<label>Description / डिस्क्रिप्शन<textarea name="description" maxlength="500" rows="3" placeholder="What is it, condition, how does it work?"></textarea></label>
<label>Your shop / name<input name="seller" maxlength="60" required placeholder="Your name or shop name"></label>
<label>Mobile number / मोबाइल नंबर<input name="phone" type="tel" maxlength="20" required placeholder="10-digit number"></label>
<label>Address / पता<textarea name="address" maxlength="300" rows="2" required placeholder="City, area so buyers can contact you"></textarea></label>
<p id="sell-msg" role="status"></p>
<div class="sh-row"><button type="button" id="sell-cancel" class="sh-btn dark">Cancel</button><button type="submit" class="sh-btn y">Post product</button></div>
</form></dialog>
<dialog id="cart"><div class="sh-row"><h2>Your cart</h2><button type="button" id="cart-close" class="sh-x">✕</button></div><div id="cart-list"></div><p class="sh-note">Payment: Cash on Delivery. Cart is saved on this phone.</p></dialog>
<dialog id="acc"><div class="sh-row"><h2>Account</h2><button type="button" id="acc-close" class="sh-x">✕</button></div><div id="acc-body"></div></dialog>
<dialog id="co"><form id="co-form"><div class="sh-row"><h2>Delivery details</h2><button type="button" id="co-close" class="sh-x">✕</button></div>
<label>Full name<input name="name" maxlength="80" required></label><label>Phone<input name="phone" type="tel" maxlength="20" required></label>
<label>Address<textarea name="address" maxlength="300" rows="2" required></textarea></label>
<div class="sh-2"><label>City<input name="city" maxlength="80" required></label><label>Pincode / ZIP<input name="pincode" maxlength="20" required></label></div>
<label>Country<input name="country" maxlength="80" required></label>
<p class="sh-note"><b>Payment: Cash on Delivery</b> (online payment coming soon). The seller will confirm your order.</p><p id="co-msg" role="status"></p>
<button type="submit" class="sh-btn y" style="width:100%">Place order</button></form></dialog>
<dialog id="ord"><div class="sh-row"><h2 id="ord-h">Orders</h2><button type="button" id="ord-close" class="sh-x">✕</button></div><div id="ord-body"></div></dialog>
<dialog id="buy">
  <div class="sh-row"><h2>Buy Now</h2><button type="button" id="buy-close" class="sh-x">✕</button></div>
  <p class="sh-t" id="buy-title" style="-webkit-line-clamp:3"></p>
  <p class="sh-p"><b id="buy-price"></b></p>
  <p class="sh-s" id="buy-seller"></p>
  <div class="buy-box">
    <div class="buy-label">Seller phone number</div>
    <div class="buy-phone" id="buy-phone">—</div>
    <p class="sh-note">No online payment yet. Call or WhatsApp the seller directly to buy. Cash on Delivery can be arranged with them.</p>
    <div class="sh-btns" style="margin-top:12px">
      <a id="buy-call" class="sh-btn y" style="text-align:center;text-decoration:none;line-height:1.2;padding:12px 8px">📞 Call</a>
      <a id="buy-wa" class="sh-btn" style="background:#25d366;color:#fff;text-align:center;text-decoration:none;line-height:1.2;padding:12px 8px">WhatsApp</a>
    </div>
  </div>
</dialog>
<div id="auth" class="au" hidden>
<a href="#" id="au-skip" class="au-skip">Skip sign in ›</a>
<div class="au-logo">stratic<span>market</span></div>
<form id="au-form" class="au-card"><h1 id="au-h">Sign in</h1>
<label id="au-name-l" hidden>Your name<input name="name" maxlength="60" autocomplete="name"></label>
<label>Email<input name="email" type="email" required autocomplete="email"></label>
<label>Password<input name="password" type="password" minlength="8" required autocomplete="current-password"></label>
<p id="au-m" role="status"></p><button id="au-go" class="au-btn">Continue</button>
<p class="au-note">Passwords need at least 8 characters. By continuing you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Notice</a>.</p></form>
<div class="au-sep"><span id="au-sw-t">New to Stratic Market?</span></div>
<button type="button" id="au-sw" class="au-btn2">Create your account</button></div>
<script src="/static/js/shop.js" defer></script>
</body></html>
