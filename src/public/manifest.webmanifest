{
  "id": "/shop",
  "name": "Stratic Market — StraticSoft",
  "short_name": "Stratic Market",
  "description": "Discover products and grow your shop with Stratic Market.",
  "lang": "en-IN",
  "start_url": "/shop?source=homescreen",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#100d19",
  "theme_color": "#171020",
  "icons": [
    {
      "src": "/static/img/stratic-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/stratic-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/stratic-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/img/stratic-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/img/stratic-icon-512.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": [
    "shopping",
    "business"
  ],
  "prefer_related_applications": false
}