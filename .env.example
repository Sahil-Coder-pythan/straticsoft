NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional AI assistant provider (keep secret on server only)
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional OTP provider: configure before production phone verification
OTP_PROVIDER=none
OTP_API_KEY=
OTP_SENDER_ID=
# Optional carrier aggregator: real rates/labels/tracking require a contracted provider
CARRIER_PROVIDER=manual
CARRIER_API_KEY=
CARRIER_API_SECRET=
CARRIER_BASE_URL=
# Uploads in production should use private object storage, not Render local disk
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
